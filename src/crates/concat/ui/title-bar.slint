import { I18n } from "i18n.slint";
import { Theme } from "theme/theme.slint";
import { Glyph, Icon } from "icons.slint";
import { PaneKind } from "workspace/pane-switcher.slint";
import { Agent } from "agent.slint";
import { Files } from "workspace/files-pane.slint";
import { Editor } from "editor.slint";

// The custom title bar.
//
// On macOS the native traffic lights are overlaid: platform.rs hides the real
// title bar (titlebar_transparent + title_hidden + fullsize_content_view) and
// this strip leaves room for the lights on the left. Everywhere else the
// platform's decorations are gone altogether and the strip draws its own
// minimise, maximise and close at the right, in that order, the way every
// window on those platforms has them. Everything that is not a control is a
// drag region — the TouchArea at the bottom of the tree starts a native
// window drag on press, and controls declared after it take their own
// presses.

// One of the strip's window buttons. Caption-button proportions rather than
// the 24px icon buttons beside Settings: wider than tall, flush with the top
// and right edges of the window, no rounding - a target you can throw the
// pointer at the corner to hit. Close hovers red, as it does everywhere.
component WindowButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> danger;

    callback clicked();

    width: 46px;
    background: touch.has-hover
        ? (root.danger ? Theme.danger : Theme.field)
        : Colors.transparent;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 12px;
        weight: 1.6;
        tint: touch.has-hover
            ? (root.danger ? Theme.on-scrim : Theme.fg)
            : Theme.fg-muted;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component HeaderIconButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <bool> enabled: true;

    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: Theme.r-sm;
    background: touch.has-hover && root.enabled ? Theme.field : Colors.transparent;

    animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 14px;
        tint: !root.enabled ? Theme.fg-dim
            : touch.has-hover ? Theme.fg : Theme.fg-muted;
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A tab of the side panel, in the strip over it: a word, on a chip when
// it is the one showing.
component PanelTab inherits VerticalLayout {
    in property <string> text;
    in property <bool> current;
    callback clicked();

    alignment: center;

    Rectangle {
        width: word.preferred-width + 20px;
        height: 26px;
        border-radius: Theme.r;
        background: root.current ? Theme.field
            : touch.has-hover ? Theme.raised : Colors.transparent;

        word := Text {
            x: 10px;
            y: (parent.height - self.height) / 2;
            text: root.text;
            color: root.current ? Theme.fg : Theme.fg-muted;
            font-size: Theme.fs;
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component TitleBar inherits Rectangle {
    in property <string> project-name: I18n.t("common.untitledProject");
    /// How wide the agent's sidebar is: the strip is that column's colour
    /// over it and the work's over the rest, with the sidebar's edge
    /// running up through it, so each column runs to the window's top.
    in property <length> side: 320px;
    /// How wide the side panel down the right is, 0 when it is closed: its
    /// tabs and buttons are the strip over it.
    in property <length> panel: 300px;
    /// Where the project's name sits: over the work, the way a
    /// conversation's title sits over the conversation, and clear of the
    /// buttons beside the lights when the sidebar is folded to a rail.
    property <length> title-x: Math.max(root.side + 9px, left.x + left.width + 16px);
    /// "saved", "saving…" — the little truth beside the name. Empty hides it.
    in property <string> status: I18n.t("common.saved");
    /// Leaves room for the traffic lights and drops nothing else; on other
    /// platforms the strip starts at the left edge.
    in property <bool> macos: true;
    /// The launch screen's face: the theme toggle and the window buttons,
    /// and nothing else. The menus act on a project, the panel picker and
    /// Export act on an edit, and on this screen there is neither — a strip
    /// of controls that all refuse is worse than a strip without them.
    in property <bool> minimal;
    /// The launch screen is under the strip, which has a ground of its own —
    /// a deeper one than the editor's. The strip takes that ground rather
    /// than its usual panel, so the launcher reads as one room and not as a
    /// dark window with a light lid. See the `launch-` ladder in theme/.
    in property <bool> deep;

    /// Draw the window buttons at the right: true wherever the platform's
    /// decorations were taken off, which is everywhere but macOS.
    in property <bool> own-buttons;
    /// The window is maximised, so the middle button restores rather than
    /// maximises and shows the two-squares glyph.
    in property <bool> maximized;

    callback begin-drag();
    callback toggle-maximize();
    callback minimize();
    callback close();
    /// A menu was asked for: which one, and where its label sits in the strip,
    /// so the sheet can hang off it.
    callback menu-opened(index: int, at-x: length, keyboard: bool);
    /// Which menu is open, or -1.
    in property <int> menu: -1;
    /// A menu asked for from the keyboard (F10, Alt+F/E/V, the arrows in
    /// an open one): `keyboard-menu` is which, and a change of
    /// `keyboard-token` is the asking. The label opens itself, since only
    /// it knows where it is.
    in property <int> keyboard-menu: -1;
    in property <int> keyboard-token;
    callback open-settings();
    /// A view was picked from the add-panel list.
    callback add-pane(kind: PaneKind);
    callback export-clicked();

    // Tall on macOS, where the lights are moved down into the middle of it
    // (platform.rs, `place_traffic_lights`); the height a caption has
    // everywhere else.
    height: root.macos ? 44px : 36px;
    background: root.deep ? Theme.launch-page : Theme.sidebar;

    // Each column's colour over it, and their edges running up through.
    if !root.minimal: Rectangle {
        x: root.side;
        width: 1px;
        background: Theme.gutter;
    }
    if !root.minimal: Rectangle {
        x: root.side + 1px;
        width: parent.width - self.x;
        background: Theme.panel;
    }
    if !root.minimal && root.panel > 0: Rectangle {
        x: parent.width - root.panel - 1px;
        width: 1px;
        background: Theme.gutter;
    }

    property <bool> drag-armed: false;
    property <length> press-x: 0px;
    property <length> press-y: 0px;

    // Whatever is not a control drags the window. Declared first so every
    // control sits above it and takes its own presses; Texts and plain
    // Rectangles are not hit targets, so presses on them fall through here.
    drag := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                root.drag-armed = true;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.up
                || event.kind == PointerEventKind.cancel) {
                root.drag-armed = false;
            }
        }
        moved => {
            if (root.drag-armed && self.pressed) {
                if (Math.abs(self.mouse-x - root.press-x) > 4px
                    || Math.abs(self.mouse-y - root.press-y) > 4px) {
                    root.drag-armed = false;
                    root.begin-drag();
                }
            }
        }
        double-clicked => {
            root.drag-armed = false;
            root.toggle-maximize();
        }
    }

    // ── the sidebar's column: the lights, its switch, the history, and a
    // new conversation at its far end ──
    left := HorizontalLayout {
        x: root.macos ? 84px : 8px;
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        spacing: 2px;
        visible: !root.minimal;

        VerticalLayout {
            alignment: center;
            HeaderIconButton {
                glyph: Glyph.panel-left;
                clicked => { Agent.shown-changed(!Agent.shown); }
            }
        }
        Rectangle { width: 6px; }
        VerticalLayout {
            alignment: center;
            HeaderIconButton {
                glyph: Glyph.undo;
                enabled: Editor.can-undo;
                clicked => { Editor.undo(); }
            }
        }
        VerticalLayout {
            alignment: center;
            HeaderIconButton {
                glyph: Glyph.redo;
                enabled: Editor.can-redo;
                clicked => { Editor.redo(); }
            }
        }
    }
    if !root.minimal && Agent.shown: VerticalLayout {
        x: root.side - self.width - 10px;
        y: 0;
        width: 26px;
        height: parent.height;
        alignment: center;
        HeaderIconButton {
            glyph: Glyph.plus;
            enabled: Agent.rows.length > 0;
            clicked => { Agent.new-chat(); }
        }
    }

    // ── the work's column: the project's name, whose menu holds File, and
    // from there the arrows to Edit and View; at its far end the window's
    // own controls and Export ──
    title := Rectangle {
        visible: !root.minimal;
        x: root.title-x;
        y: (parent.height - self.height) / 2;
        width: name.preferred-width + 34px;
        height: 26px;
        border-radius: Theme.r;
        background: (root.menu >= 0 || title-touch.has-hover) ? Theme.field : Colors.transparent;

        name := Text {
            x: 8px;
            y: (parent.height - self.height) / 2;
            text: root.project-name;
            color: Theme.fg;
            font-size: Theme.fs;
            font-weight: Theme.weight-title;
        }
        Icon {
            x: parent.width - self.width - 8px;
            y: (parent.height - self.height) / 2;
            glyph: Glyph.chevron-down;
            size: 10px;
            weight: 2.4;
            tint: Theme.fg-muted;
        }

        title-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.menu-opened(0, title.absolute-position.x - root.absolute-position.x, false);
            }
        }

        property <int> asked: root.keyboard-token;
        changed asked => {
            if (root.keyboard-menu >= 0) {
                root.menu-opened(root.keyboard-menu,
                    title.absolute-position.x - root.absolute-position.x, true);
            }
        }
    }
    Text {
        visible: !root.minimal;
        x: title.x + title.width + 6px;
        y: (parent.height - self.height) / 2;
        text: root.status;
        color: Theme.fg-dim;
        font-size: Theme.fs-xs;
    }

    HorizontalLayout {
        x: parent.width - root.panel - (root.panel > 0 ? 1px : 0px) - self.width;
        y: 0;
        width: self.preferred-width;
        height: parent.height;
        // No right padding when the strip ends in its own buttons: the close
        // button belongs in the corner, not eight pixels shy of it.
        padding-right: root.own-buttons && root.panel == 0 ? 0px : 10px;
        spacing: 2px;

        // The one control on both screens: nothing behind it needs a
        // project, and it is the only way through to the theme.
        VerticalLayout {
            alignment: center;
            HeaderIconButton {
                glyph: Glyph.settings;
                clicked => { root.open-settings(); }
            }
        }

        // The side panel, folded away: what brings it back.
        if !root.minimal && root.panel == 0: VerticalLayout {
            alignment: center;
            HeaderIconButton {
                glyph: Glyph.panel-right;
                clicked => { Files.panel-shown = true; }
            }
        }

        // Plain, as a conversation's Share is: a word and its mark, lit
        // only under the pointer.
        if !root.minimal: VerticalLayout {
            alignment: center;
            padding-left: 4px;

            Rectangle {
                width: label.width + icon.width + 22px;
                height: 26px;
                border-radius: Theme.r;
                background: export-touch.has-hover ? Theme.field : Colors.transparent;

                animate background { duration: 100ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }

                icon := Icon {
                    x: 8px;
                    y: (parent.height - self.height) / 2;
                    glyph: Glyph.export;
                    size: 13px;
                    tint: Theme.fg;
                }

                label := Text {
                    x: icon.x + icon.width + 6px;
                    y: (parent.height - self.height) / 2;
                    text: I18n.t("common.export");
                    color: Theme.fg;
                    font-size: Theme.fs;
                }

                export-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.export-clicked(); }
                }
            }
        }

        // The window's own buttons, when nothing is to the right of them.
        if root.own-buttons && root.panel == 0: Rectangle { width: 6px; }
        if root.own-buttons && root.panel == 0: HorizontalLayout {
            spacing: 0px;
            WindowButton {
                glyph: Glyph.minus;
                clicked => { root.minimize(); }
            }
            WindowButton {
                glyph: root.maximized ? Glyph.copy : Glyph.maximize;
                clicked => { root.toggle-maximize(); }
            }
            WindowButton {
                glyph: Glyph.close;
                danger: true;
                clicked => { root.close(); }
            }
        }
    }

    // ── the side panel's column: its tabs, and its buttons ──
    if !root.minimal && root.panel > 0: HorizontalLayout {
        x: parent.width - root.panel;
        y: 0;
        width: root.panel;
        height: parent.height;
        padding-left: 10px;
        padding-right: root.own-buttons ? 0px : 8px;
        spacing: 2px;

        PanelTab {
            text: I18n.t("files.videos");
            current: Files.panel-tab == 0;
            clicked => { Files.panel-tab = 0; }
        }
        PanelTab {
            text: I18n.t("files.title");
            current: Files.panel-tab == 1;
            clicked => { Files.panel-tab = 1; }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;
            if Files.panel-tab == 0: HeaderIconButton {
                glyph: Glyph.plus;
                clicked => { Editor.tab-added(); }
            }
            if Files.panel-tab == 1: HeaderIconButton {
                glyph: Glyph.folder;
                clicked => { Files.open-folder(); }
            }
        }
        VerticalLayout {
            alignment: center;
            HeaderIconButton {
                glyph: Glyph.close;
                clicked => { Files.panel-shown = false; }
            }
        }

        if root.own-buttons: Rectangle { width: 6px; }
        if root.own-buttons: HorizontalLayout {
            spacing: 0px;
            WindowButton {
                glyph: Glyph.minus;
                clicked => { root.minimize(); }
            }
            WindowButton {
                glyph: root.maximized ? Glyph.copy : Glyph.maximize;
                clicked => { root.toggle-maximize(); }
            }
            WindowButton {
                glyph: Glyph.close;
                danger: true;
                clicked => { root.close(); }
            }
        }
    }
}

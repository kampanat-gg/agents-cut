// The Files pane: the project's folder as a list, what the agent made
// and what the user brought, kept up to date as files come and go.
//
// A file the timeline can take - a picture, a video, a sound - drags onto
// the lanes, and a double-click lays it at the playhead; it joins the bin
// on the way, so there is no import step. The rest open in the
// application the system gives them. A right-click offers the same, and
// a way to name the file to the agent.

import { I18n } from "../i18n.slint";
import { Theme } from "../theme/theme.slint";
import { Glyph, Icon } from "../icons.slint";
import { Fmt, Payload } from "../util.slint";
import { Editor } from "../editor.slint";
import { Agent } from "../agent.slint";
import { IconButton } from "../primitives/panel.slint";
import { Tip } from "../primitives/tooltip.slint";
import { Pane, PaneHeader, PaneScroll } from "pane.slint";
import { PaneKind, PaneSwitcher } from "pane-switcher.slint";

/// One line of the list: a folder or a file, `depth` folders down.
export struct FileRow {
    /// Relative to the project's folder, with forward slashes: what the
    /// drag payload and every callback name it by.
    path: string,
    name: string,
    depth: int,
    folder: bool,
    /// A folder whose contents are listed under it.
    open: bool,
    /// "image", "video", "audio", "text", or "other".
    kind: string,
    /// A file's size, a folder's count.
    meta: string,
    /// The timeline can take it.
    placeable: bool,
    /// A picture's own, small, once it is made; `thumbed` says it is.
    thumb: image,
    thumbed: bool,
}

/// One of the project's videos: a timeline, as a card.
export struct VideoCard {
    name: string,
    /// How long it runs, in seconds.
    seconds: float,
    /// Its frame and rate, "1080 × 1920 · 24 fps".
    frame: string,
    /// Its frame's width over its height: the shape its picture is drawn
    /// in on the card.
    aspect: float,
    /// The earliest picture on it, small; `thumbed` says there is one.
    thumb: image,
    thumbed: bool,
    /// It is the timeline open in the editor.
    current: bool,
    /// Its episode's folder, relative to the project, when it has one,
    /// and what that folder's brief.md says of it.
    folder: string,
    synopsis: string,
    /// idea, storyboard, building, done or exported; empty when unsaid.
    status: string,
}

/// One beat of an episode's storyboard, as its storyboard.md says it.
export struct StoryBeat {
    time: string,
    title: string,
    voice: string,
    picture: string,
    motion: string,
    sound: string,
    /// The picture's file, small, when the beat names one that is there.
    image: image,
    has-image: bool,
}

export global Files {
    in-out property <[FileRow]> rows;
    /// The project's videos, one a timeline, for the side panel.
    in-out property <[VideoCard]> videos;
    /// The side panel is open, and which tab: 0 the videos, 1 the files.
    in-out property <bool> panel-shown: true;
    /// The side panel's width, which its edge drags.
    in-out property <length> panel-width: 300px;
    /// The card whose storyboard is open in the centre, or -1, and the
    /// storyboard's beats.
    in-out property <int> storyboard: -1;
    in-out property <[StoryBeat]> beats;
    callback storyboard-opened(folder: string);
    callback storyboard-closed();
    in-out property <int> panel-tab: 0;
    /// A folder's arrow, or a double-click on it.
    callback toggle(path: string);
    /// A file double-clicked.
    callback activate(path: string);
    /// A row of a file's menu: "add", "mention", "open" or "reveal".
    callback action(path: string, action: string);
    /// The header's folder button: the project's folder in the system's
    /// file manager.
    callback open-folder();
    /// New video: the next episode, with its folder and its conversation.
    callback new-video();
}

component MenuRow inherits Rectangle {
    in property <string> text;
    in property <Glyph> glyph;
    callback chosen();

    height: 28px;
    border-radius: Theme.r-sm;
    background: touch.has-hover ? Theme.field-hover : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon { glyph: root.glyph; size: 13px; }
        }
        Text {
            text: root.text;
            color: Theme.fg;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.chosen(); }
    }
}

component Line inherits Rectangle {
    in property <FileRow> line;
    in property <bool> selected;
    callback picked();
    callback menu(x: length, y: length);

    property <length> indent: 10px + root.line.depth * 14px;
    property <brush> ink: root.line.kind == "image" ? Theme.kind-image
        : root.line.kind == "video" ? Theme.kind-video
        : root.line.kind == "audio" ? Theme.kind-audio
        : Theme.fg-muted;

    height: 30px;

    drag := DragArea {
        // A file the lanes cannot take carries nothing, which is how a
        // DragArea opts out.
        data: Payload.of(root.line.placeable ? "file:" + root.line.path : "");
        drag-image: Payload.preview(root.line.placeable ? "file:" + root.line.path : "");
        drag-image-offset-x: -8;
        drag-image-offset-y: -4;
        allow-copy: true;

        Rectangle {
            x: 4px;
            width: parent.width - 8px;
            border-radius: Theme.r-sm;
            background: root.selected ? Theme.field-active
                : touch.has-hover ? Theme.field-hover : transparent;

            // The folder's arrow, or room for one, so names line up.
            if root.line.folder: Icon {
                x: root.indent - 4px;
                y: (parent.height - self.height) / 2;
                glyph: root.line.open ? Glyph.chevron-down : Glyph.chevron-right;
                size: 10px;
                weight: 2.6;
                tint: Theme.fg-dim;
            }

            if root.line.thumbed: Rectangle {
                x: root.indent + 10px;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                border-radius: 3px;
                clip: true;
                Image {
                    source: root.line.thumb;
                    image-fit: cover;
                }
            }
            if !root.line.thumbed: Icon {
                x: root.indent + 12px;
                y: (parent.height - self.height) / 2;
                glyph: root.line.folder ? Glyph.folder
                    : root.line.kind == "image" ? Glyph.image
                    : root.line.kind == "video" ? Glyph.film
                    : root.line.kind == "audio" ? Glyph.music
                    : root.line.kind == "text" ? Glyph.book
                    : Glyph.file;
                size: 15px;
                tint: root.line.folder ? Theme.fg-muted : root.ink;
            }

            Text {
                x: root.indent + 38px;
                width: parent.width - self.x - meta.width - 14px;
                height: parent.height;
                text: root.line.name;
                color: Theme.fg;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                overflow: elide;
            }
            meta := Text {
                x: parent.width - self.width - 8px;
                height: parent.height;
                text: root.line.meta;
                color: Theme.fg-dim;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
            }

            touch := TouchArea {
                clicked => { root.picked(); }
                double-clicked => {
                    if (root.line.folder) {
                        Files.toggle(root.line.path);
                    } else {
                        Files.activate(root.line.path);
                    }
                }
                pointer-event(event) => {
                    if (event.button == PointerEventButton.right
                        && event.kind == PointerEventKind.down) {
                        root.picked();
                        if (!root.line.folder) {
                            root.menu(self.mouse-x, self.mouse-y);
                        }
                    }
                }
            }

            // A folder's whole line opens and closes it on one click; a
            // double-click is the same toggle, which Rust takes once.
            if root.line.folder: TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.picked();
                    Files.toggle(root.line.path);
                }
            }
        }
    }
}

/// The project's folder as lines, with a file's menu: the Files pane's
/// body, and the side panel's Files tab.
export component FileList inherits Rectangle {
    /// The line picked last, by path; the list's own, not the project's.
    property <string> selected;
    /// The file a menu was opened on, and where.
    property <FileRow> menu-row;
    property <length> menu-x;
    property <length> menu-y;

    if Files.rows.length == 0: VerticalLayout {
        padding: 24px;
        alignment: center;
        spacing: 6px;
        Text {
            text: I18n.t("files.empty");
            color: Theme.fg;
            font-size: Theme.fs;
            horizontal-alignment: center;
        }
        Text {
            text: I18n.t("files.emptyNote");
            color: Theme.fg-dim;
            font-size: Theme.fs-sm;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    PaneScroll {
        VerticalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            for row in Files.rows: Line {
                line: row;
                selected: row.path == root.selected;
                picked => { root.selected = row.path; }
                menu(x, y) => {
                    root.menu-row = row;
                    root.menu-x = self.absolute-position.x - root.absolute-position.x + x;
                    root.menu-y = self.absolute-position.y - root.absolute-position.y + y;
                    menu.show();
                }
            }
        }
    }

    menu := PopupWindow {
        x: Math.min(root.menu-x, root.width - 196px);
        y: root.menu-y;
        width: 188px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.field;
            border-width: 1px;
            border-color: Theme.line-strong;
            border-radius: Theme.r;

            VerticalLayout {
                padding: 4px;
                if root.menu-row.placeable: MenuRow {
                    text: I18n.t("files.add");
                    glyph: Glyph.plus;
                    chosen => { menu.close(); Files.action(root.menu-row.path, "add"); }
                }
                MenuRow {
                    text: I18n.t("files.mention");
                    glyph: Glyph.sparkle;
                    chosen => { menu.close(); Files.action(root.menu-row.path, "mention"); }
                }
                MenuRow {
                    text: I18n.t("files.open");
                    glyph: Glyph.arrow-up-right;
                    chosen => { menu.close(); Files.action(root.menu-row.path, "open"); }
                }
                MenuRow {
                    text: I18n.t("files.reveal");
                    glyph: Glyph.folder;
                    chosen => { menu.close(); Files.action(root.menu-row.path, "reveal"); }
                }
            }
        }
    }
}

export component FilesPane inherits Pane {
    in property <int> pane-seat;
    in property <bool> pane-removable;
    callback pane-picked(kind: PaneKind);
    callback pane-removed();

    PaneHeader {
        title: I18n.t("files.title");

        IconButton {
            glyph: Glyph.folder;
            label: I18n.t("files.openFolder");
            clicked => { Files.open-folder(); }
        }
        VerticalLayout {
            alignment: center;
            PaneSwitcher {
                kind: PaneKind.files;
                seat: root.pane-seat;
                removable: root.pane-removable;
                picked(kind) => { root.pane-picked(kind); }
                removed => { root.pane-removed(); }
            }
        }
    }

    FileList {
        vertical-stretch: 1;
    }
}

// ── the side panel ───────────────────────────────────────────────────────
//
// A column down the window's right, outside the dock, as the agent's is
// down its left: the project's videos, one a timeline, and its files.
// Its tabs and buttons are in the title bar, over it.

component Card inherits Rectangle {
    in property <VideoCard> video;
    /// Its place in the project's list of timelines.
    in property <int> index;
    callback picked();
    callback menu(x: length, y: length);

    /// The name is being typed over.
    property <bool> naming;

    // The picture's square and its margins, or the words when they run
    // longer - a synopsis and a status under the name.
    height: Math.max(112px, info.preferred-height);
    border-radius: Theme.r-lg;
    // Flat with a hairline edge, as Claude's cards are; the open one a
    // step up from the ground.
    background: root.video.current || touch.has-hover ? Theme.raised : transparent;
    border-width: 1px;
    border-color: root.video.current ? Theme.line-strong : Theme.line;

    callback storyboard();

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
        // A double-click on a card names it again, as it did on a tab.
        double-clicked => {
            root.naming = true;
            field.text = root.video.name;
            field.focus();
            field.select-all();
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right
                && event.kind == PointerEventKind.down) {
                root.menu(self.mouse-x, self.mouse-y);
            }
        }
    }

    // The picture in its own frame's shape - upright for a short, wide
    // for a 16:9 - fitted into the same square on every card, so the
    // names line up and nothing of the picture is cut away.
    property <length> slot: 96px;
    property <float> shape: Math.max(0.1, root.video.aspect);
    Rectangle {
        x: 8px;
        y: 8px;
        width: root.slot;
        height: root.slot;
        border-radius: 8px;
        background: Theme.page;
    }
    Rectangle {
        width: root.shape >= 1 ? root.slot : root.slot * root.shape;
        height: root.shape >= 1 ? root.slot / root.shape : root.slot;
        x: 8px + (root.slot - self.width) / 2;
        y: 8px + (root.slot - self.height) / 2;
        border-radius: 6px;
        background: Theme.well;
        clip: true;

        if root.video.thumbed: Image {
            source: root.video.thumb;
            image-fit: cover;
        }
        if !root.video.thumbed: Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            glyph: Glyph.film;
            size: 16px;
            tint: Theme.fg-dim;
        }
    }

    info := VerticalLayout {
        x: 8px + root.slot + 12px;
        width: parent.width - self.x - 10px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 4px;
        alignment: start;

        Rectangle {
            height: 20px;

            if !root.naming: Text {
                width: parent.width;
                height: parent.height;
                text: root.video.name;
                color: Theme.fg;
                font-size: Theme.fs;
                font-weight: Theme.weight-title;
                vertical-alignment: center;
                overflow: elide;
            }
            field := TextInput {
                visible: root.naming;
                width: parent.width;
                height: parent.height;
                color: Theme.fg;
                font-size: Theme.fs;
                font-weight: Theme.weight-title;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                accepted => {
                    if (self.text != "") {
                        Editor.tab-renamed(root.index, self.text);
                    }
                    root.naming = false;
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.naming = false;
                        return accept;
                    }
                    return reject;
                }
                changed has-focus => {
                    if (!self.has-focus) {
                        root.naming = false;
                    }
                }
            }
        }
        Text {
            text: Fmt.short-duration(root.video.seconds) + "  ·  " + root.video.frame;
            color: Theme.fg-dim;
            font-size: Theme.fs-xs;
        }
        if root.video.synopsis != "": Text {
            text: root.video.synopsis;
            color: Theme.fg-muted;
            font-size: Theme.fs-sm;
            wrap: word-wrap;
            max-height: 34px;
            overflow: elide;
        }
        if root.video.status != "": HorizontalLayout {
            alignment: start;
            padding-top: 2px;
            Rectangle {
                height: 18px;
                width: chip.preferred-width + 14px;
                border-radius: 9px;
                background: root.video.status == "done" || root.video.status == "exported"
                    ? Theme.accent-soft : Theme.field;
                chip := Text {
                    x: 7px;
                    y: (parent.height - self.height) / 2;
                    text: root.video.status == "idea" ? I18n.t("files.statusIdea")
                        : root.video.status == "storyboard" ? I18n.t("files.statusStoryboard")
                        : root.video.status == "building" ? I18n.t("files.statusBuilding")
                        : root.video.status == "done" ? I18n.t("files.statusDone")
                        : root.video.status == "exported" ? I18n.t("files.statusExported")
                        : root.video.status;
                    color: root.video.status == "done" || root.video.status == "exported"
                        ? Theme.accent : Theme.fg-muted;
                    font-size: Theme.fs-xs;
                    font-weight: Theme.weight-title;
                }
            }
        }
    }

    // The episode's storyboard, in the centre: a card with a folder has one
    // to open, written yet or not.
    if root.video.folder != "": Rectangle {
        x: parent.width - self.width - 8px;
        y: 8px;
        width: 26px;
        height: 26px;
        border-radius: Theme.r;
        background: board.has-hover ? Theme.field-hover : transparent;

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            glyph: Glyph.rows;
            size: 14px;
            tint: board.has-hover ? Theme.fg : Theme.fg-muted;
        }
        board := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.storyboard(); }
        }
        Tip {
            text: I18n.t("files.openStoryboard");
            active: board.has-hover;
        }
    }
}

/// The project's videos as cards, and a button for one more.
export component VideoList inherits Rectangle {
    /// The card a menu was opened on, and where.
    property <int> menu-index;
    property <length> menu-x;
    property <length> menu-y;

    PaneScroll {
        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            for video[index] in Files.videos: Card {
                video: video;
                index: index;
                // Picking a card puts its episode's conversation on
                // screen (the app starts the episode if it has none yet),
                // and an open storyboard turns to its own.
                storyboard => {
                    Editor.tab-selected(index);
                    Files.storyboard = index;
                    Files.storyboard-opened(Files.videos[index].folder);
                }
                picked => {
                    Editor.tab-selected(index);
                    if (Files.storyboard >= 0) {
                        Files.storyboard = index;
                        Files.storyboard-opened(Files.videos[index].folder);
                    }
                }
                menu(x, y) => {
                    root.menu-index = index;
                    root.menu-x = self.absolute-position.x - root.absolute-position.x + x;
                    root.menu-y = self.absolute-position.y - root.absolute-position.y + y;
                    menu.show();
                }
            }

            Rectangle {
                height: 36px;
                border-radius: Theme.r;
                border-width: 1px;
                border-color: Theme.line;
                background: add.has-hover ? Theme.raised : transparent;

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon { glyph: Glyph.plus; size: 13px; }
                    }
                    Text {
                        text: I18n.t("files.newVideo");
                        color: Theme.fg-muted;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                }

                add := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Files.new-video(); }
                }
            }
        }
    }

    menu := PopupWindow {
        x: Math.min(root.menu-x, root.width - 176px);
        y: root.menu-y;
        width: 168px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.field;
            border-width: 1px;
            border-color: Theme.line-strong;
            border-radius: Theme.r;

            VerticalLayout {
                padding: 4px;
                // The last video stays: a project is never without one,
                // and the window refuses it the way a tab's close did.
                MenuRow {
                    text: I18n.t("files.removeVideo");
                    glyph: Glyph.trash;
                    chosen => {
                        menu.close();
                        Editor.tab-close-requested(root.menu-index);
                    }
                }
            }
        }
    }
}

/// The panel itself: the tab the title bar has picked.
export component SidePanel inherits Rectangle {
    background: Theme.panel;
    clip: true;

    if Files.panel-tab == 0: VideoList {}
    if Files.panel-tab == 1: FileList {}
}

/// An episode's storyboard over the monitor and the timeline: its brief
/// up top, its beats in order - when, what is seen, what is said, how it
/// moves, what is heard - and the two things to do with it: have Claude
/// write or revise it, or build the episode from it.
export component StoryboardView inherits Rectangle {
    property <VideoCard> video: Files.storyboard >= 0 && Files.storyboard < Files.videos.length
        ? Files.videos[Files.storyboard] : Files.videos[0];

    background: Theme.panel;

    // A press anywhere stays here, not on the panes under it.
    TouchArea {}

    VerticalLayout {
        padding: 24px;
        padding-bottom: 0px;
        spacing: 16px;

        // ── the brief ──
        HorizontalLayout {
            spacing: 12px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                Text {
                    text: root.video.name;
                    color: Theme.fg;
                    font-size: Theme.fs-xl + 4px;
                    font-weight: Theme.weight-title;
                    overflow: elide;
                }
                if root.video.synopsis != "": Text {
                    text: root.video.synopsis;
                    color: Theme.fg-muted;
                    font-size: Theme.fs-lg;
                    wrap: word-wrap;
                }
                Text {
                    text: Fmt.short-duration(root.video.seconds) + "  ·  " + root.video.frame
                        + "  ·  " + Files.beats.length + " " + I18n.t("files.beats");
                    color: Theme.fg-dim;
                    font-size: Theme.fs-sm;
                }
            }

            VerticalLayout {
                alignment: start;
                HorizontalLayout {
                    spacing: 8px;

                    // Claude writes it, or changes it, in the episode's own
                    // conversation.
                    Rectangle {
                        width: ask-row.preferred-width + 24px;
                        height: 32px;
                        border-radius: Theme.r;
                        background: ask.has-hover ? Theme.field-hover : Theme.field;
                        ask-row := HorizontalLayout {
                            x: 12px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    width: 13px;
                                    height: 13px;
                                    source: @image-url("../logos/claude-color.svg");
                                }
                            }
                            Text {
                                text: Files.beats.length == 0 ? I18n.t("files.writeStoryboard")
                                    : I18n.t("files.reviseStoryboard");
                                color: Theme.fg;
                                font-size: Theme.fs;
                                vertical-alignment: center;
                            }
                        }
                        ask := TouchArea {
                            enabled: !Agent.busy;
                            mouse-cursor: pointer;
                            clicked => {
                                if (Files.beats.length == 0) {
                                    Agent.send(I18n.t("files.storyboardPrompt"));
                                } else {
                                    Agent.mention(I18n.t("files.revisePrefix"));
                                }
                            }
                        }
                    }

                    // Build it: the plan becomes the timeline.
                    if Files.beats.length > 0: Rectangle {
                        width: build-row.preferred-width + 24px;
                        height: 32px;
                        border-radius: Theme.r;
                        background: build.has-hover ? Theme.accent-hover : Theme.accent;
                        opacity: Agent.busy ? 0.5 : 1;
                        build-row := HorizontalLayout {
                            x: 12px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    glyph: Glyph.play;
                                    size: 12px;
                                    tint: Theme.on-accent;
                                }
                            }
                            Text {
                                text: I18n.t("files.buildEpisode");
                                color: Theme.on-accent;
                                font-size: Theme.fs;
                                font-weight: Theme.weight-title;
                                vertical-alignment: center;
                            }
                        }
                        build := TouchArea {
                            enabled: !Agent.busy;
                            mouse-cursor: pointer;
                            clicked => {
                                Agent.send(I18n.t("files.buildPrompt"));
                                Files.storyboard = -1;
                                Files.storyboard-closed();
                            }
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: Theme.r;
                        background: shut.has-hover ? Theme.field-hover : transparent;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            glyph: Glyph.close;
                            size: 14px;
                            tint: Theme.fg-muted;
                        }
                        shut := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                Files.storyboard = -1;
                                Files.storyboard-closed();
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // ── the beats ──
        if Files.beats.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 6px;
            Text {
                text: I18n.t("files.noStoryboard");
                color: Theme.fg;
                font-size: Theme.fs-lg;
                horizontal-alignment: center;
            }
            Text {
                text: I18n.t("files.noStoryboardNote");
                color: Theme.fg-dim;
                font-size: Theme.fs;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        if Files.beats.length > 0: PaneScroll {
            vertical-stretch: 1;

            VerticalLayout {
                padding-bottom: 24px;
                spacing: 10px;

                for beat[index] in Files.beats: Rectangle {
                    height: Math.max(176px, words.preferred-height + 24px);
                    border-radius: Theme.r-lg;
                    border-width: 1px;
                    border-color: Theme.line;

                    // When, and which beat.
                    VerticalLayout {
                        x: 14px;
                        y: 12px;
                        width: 64px;
                        spacing: 4px;
                        alignment: start;
                        Text {
                            text: "\{index + 1}";
                            color: Theme.fg-dim;
                            font-size: Theme.fs-sm;
                        }
                        Text {
                            text: beat.time;
                            color: Theme.fg;
                            font-size: Theme.fs-sm;
                            font-weight: Theme.weight-title;
                            wrap: word-wrap;
                        }
                    }

                    // What is seen: the picture when it is made, the
                    // words for it when it is not yet.
                    Rectangle {
                        x: 86px;
                        y: 12px;
                        width: 86px;
                        height: 152px;
                        border-radius: 8px;
                        background: Theme.well;
                        clip: true;

                        if beat.has-image: Image {
                            source: beat.image;
                            image-fit: cover;
                        }
                        if !beat.has-image: Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            glyph: Glyph.image;
                            size: 18px;
                            tint: Theme.fg-dim;
                        }
                    }

                    words := VerticalLayout {
                        x: 188px;
                        y: 12px;
                        width: parent.width - self.x - 14px;
                        spacing: 6px;
                        alignment: start;

                        if beat.title != "": Text {
                            text: beat.title;
                            color: Theme.fg;
                            font-size: Theme.fs-lg;
                            font-weight: Theme.weight-title;
                            wrap: word-wrap;
                        }
                        if beat.voice != "": Text {
                            text: beat.voice;
                            color: Theme.fg;
                            font-size: Theme.fs-lg;
                            wrap: word-wrap;
                        }
                        if beat.picture != "": Text {
                            text: I18n.t("files.beatPicture") + "  " + beat.picture;
                            color: Theme.fg-muted;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                        }
                        if beat.motion != "": Text {
                            text: I18n.t("files.beatMotion") + "  " + beat.motion;
                            color: Theme.fg-muted;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                        }
                        if beat.sound != "": Text {
                            text: I18n.t("files.beatSound") + "  " + beat.sound;
                            color: Theme.fg-muted;
                            font-size: Theme.fs-sm;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
